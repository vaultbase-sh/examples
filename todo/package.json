{
  "name": "vaultbase-example-todo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A todo app on Vaultbase: sign-in, per-user rules, realtime sync across tabs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "types": "vb-types --schema=./schema.json --out=./src/lib/vaultbase-schema.gen.ts"
  },
  "dependencies": {
    "@vaultbase/sdk": "^0.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
